<% count = 0 %>
<% @posts.each do |post| %>
  <% count += 1%>

  <h3>Post #<%=count%></h3>
  <%= post.title %> <br>
  <%= post.content%> <br> 
  <% if user_signed_in? %>
  <p>Email: <%= post.user&.email%></p>

  <%end%>
<%end%>

